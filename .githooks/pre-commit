#!/bin/sh
# Pre-commit secret guard.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Runs ggshield when a GitGuardian API key is configured (it needs an account),
# then the built-in pattern scan, which needs no account and always runs.
#
# Bypass a single commit with `git commit --no-verify`.

root="$(git rev-parse --show-toplevel)" || exit 0
cd "$root" || exit 0

if [ -n "${GITGUARDIAN_API_KEY:-}" ] && command -v ggshield >/dev/null 2>&1; then
  echo "secret-scan: ggshield..."
  ggshield secret scan pre-commit || exit 1
fi

exec sh scripts/secret-scan.sh staged
